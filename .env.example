# PostgreSQL connection string used by Prisma and the Next.js server.
# Copy this file to .env and adjust the credentials for your machine.
# With the included Docker Compose file, the values below work as-is.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sms_registry?schema=public"

# Fixed registry desk account. Staff cannot self-register.
STAFF_EMAIL="registry@sms.local"
STAFF_PASSWORD="change-me"

# Secret used to sign the session cookie. Use at least 32 random characters.
SESSION_SECRET="replace-with-a-long-random-string"
